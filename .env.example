# Local-only runtime secrets for optional Volcengine / Seedance execution.
# Copy this file to .env before any real provider run.
# .env must stay local and must not be committed to GitHub.
# ARK_API_KEY is required. Without a valid API key the provider flow cannot run.

ARK_API_KEY=your_ark_api_key_here
VOLCENGINE_TTS_ACCESS_TOKEN=your_volcengine_tts_access_token_here
CUSTOM_SFX_API_KEY=your_sfx_provider_token_here
CUSTOM_MUSIC_API_KEY=your_music_provider_token_here